#!/bin/sh
# Runs once, as root, before either service starts. It chooses the services'
# identity and prepares the folders that belong to Menagerie.
#
# Both services run as the owner of the configured workspace root, so every
# file they, Toha's hooks and initializeCommand write into a workspace
# belongs to the operator who owns that root. The workspace service's
# groups add the Docker socket's, the Docker proxy's when DOCKER_HOST names
# it, and the Wyrwood consumer directory's, so both stay reachable. The template service never talks to Docker: its
# groups add only the Wyrwood directory's, for Toha's ssh transport. A
# root-owned workspace root keeps the services root.
set -eu
config=/etc/menagerie/config.yml
data=/var/lib/menagerie
fail() {
  echo "menagerie: $1" >&2
  exit 1
}

# A restarted container may keep /run: clear the previous stop's marker.
rm -rf /run/menagerie-stopping

root=$(/usr/local/bin/menagerie -config "$config" -print-workspace-root) || fail "the configuration in $config is not valid"
wyrwood=$(/usr/local/bin/menagerie -config "$config" -print-wyrwood-directory)
[ -d "$root" ] || fail "the workspace root $root is not mounted"
# The configured paths may be symbolic links, like any mounted path; the
# identity is their target's.
uid=$(stat -L -c %u "$root")
gid=$(stat -L -c %g "$root")

# with_group LIST PATH prints LIST with PATH's group added once.
with_group() {
  [ -e "$2" ] || {
    echo "$1"
    return
  }
  group=$(stat -L -c %g "$2")
  case ",$1," in *",$group,"*) echo "$1" ;; *) echo "$1,$group" ;; esac
}
socket=/var/run/docker.sock
case "${DOCKER_HOST:-}" in
  unix://*)
    socket=${DOCKER_HOST#unix://}
    # A Docker proxy started beside Menagerie may not have bound its socket
    # yet; its group is only known once it has. Without it after the wait,
    # the services start and Docker calls fail until the next start.
    tries=0
    while [ ! -S "$socket" ] && [ "$tries" -lt 30 ]; do
      sleep 1
      tries=$((tries + 1))
    done
    [ -S "$socket" ] || echo "menagerie: no Docker socket at $socket; the workspace service starts without its group" >&2
    ;;
esac
template_groups=$(with_group "$gid" "$wyrwood")
groups=$(with_group "$template_groups" "$socket")

if [ "$uid" = 0 ]; then
  user=root home=/root
else
  home=$data/home
  # ssh and git look the user up; give a numeric owner a passwd entry.
  getent group "$gid" >/dev/null || groupadd --gid "$gid" menagerie
  if ! getent passwd "$uid" >/dev/null; then
    useradd --uid "$uid" --gid "$gid" --no-create-home --home-dir "$home" --shell /usr/sbin/nologin menagerie
  fi
  user=$(getent passwd "$uid" | cut -d: -f1)
fi

# Menagerie's own folders: the template service's socket folder, open to
# the services' user only, and Toha's data and the user's home in the data
# volume. menagerie-folders checks each through a descriptor opened without
# following links, refuses data another uid wrote, and gives only the
# checked folders themselves to the user.
/usr/local/bin/menagerie-folders -uid "$uid" -gid "$gid" -root "$root" || exit 1

# The template service's groups are the fewer; the workspace service's add
# to them.
/command/s6-applyuidgid -u "$uid" -g "$gid" -G "$template_groups" test -r "$config" ||
  fail "$config is not readable by uid $uid"

cat >/run/menagerie-identity <<IDENTITY
uid=$uid
gid=$gid
groups=$groups
template_groups=$template_groups
user=$user
home=$home
IDENTITY
echo "menagerie: services run as $user (uid $uid, gid $gid, groups $groups), the owner of $root; the template service has groups $template_groups"
