#!/command/with-contenv sh
# The template service: Toha interviews, generation and upgrades on the
# private Unix socket. It reads /etc/menagerie/config.yml and keeps Toha's
# data under /var/lib/menagerie/toha.
# It runs as the user menagerie-prepare chose, without the Docker socket's
# group: it never talks to Docker.
# shellcheck source=/dev/null disable=SC2154 # menagerie-prepare writes these values
. /run/menagerie-identity
export HOME="$home" USER="$user" LOGNAME="$user"
exec /command/s6-applyuidgid -u "$uid" -g "$gid" -G "$template_groups" /usr/local/bin/menagerie-template-service
